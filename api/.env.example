# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=decentralized_host

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Mail Server Configuration
MAIL_SMTP_PORT=25
MAIL_SMTP_TLS_PORT=587
MAIL_IMAP_PORT=993
MAIL_IMAP_PLAIN_PORT=143
MAIL_FROM_DOMAIN=localhost
MAIL_ENCRYPTION_KEY=your-encryption-key-change-this
MAIL_ATTACHMENT_STORAGE=/tmp/mail_attachments
MAX_ATTACHMENT_SIZE_MB=25

# Outbound SMTP (for relay if needed)
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=your-email@gmail.com
SMTP_RELAY_PASSWORD=your-app-password

# Redis (for queue management)
REDIS_URL=redis://localhost:6379

# Mail Service
MAIL_AUTO_REPLY_ENABLED=true
MAIL_SPAM_FILTER_ENABLED=true
MAIL_ENCRYPTION_ENABLED=true
MAIL_MAX_STORAGE_MB=5120
MAIL_QUEUE_RETRY_ATTEMPTS=5
MAIL_QUEUE_RETRY_DELAY_MS=300000
