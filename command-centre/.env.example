# Which platform the console talks to. Required: there is no default.
#   controlplane — the Decentralized.Host control plane (production)
#   demo         — replay of a recorded dev-cluster view, every value SIMULATED,
#                  all mutations refused. Refused when NODE_ENV=production
#                  unless ALLOW_DEMO_IN_PRODUCTION=1.
PLATFORM_ADAPTER=controlplane

# Comma-separated control-plane member API URLs (tried in order on transport errors).
DH_CONTROL_URL=https://cp1.example.net:7700,https://cp2.example.net:7700,https://cp3.example.net:7700
# With TLS, trust the cluster CA:  NODE_EXTRA_CA_CERTS=/path/to/root-ca.pem
# Total time budget for one control-plane exchange across all members (ms).
DH_CONTROL_TIMEOUT_MS=5000

# Optional: map positions per host region (hosts do not report coordinates).
# DH_REGION_LOCATIONS={"eu-west":[50.1,8.7],"ap-south":[19.1,72.9]}

# Cookies are Secure by default in production; override with 1 / 0.
# COOKIE_SECURE=1

# Optional Copilot model rephrasing. OFF by default: it sends retrieved
# platform data to Google.
# COPILOT_MODEL=gemini
# GEMINI_API_KEY=...

PORT=3000
HOST=127.0.0.1
