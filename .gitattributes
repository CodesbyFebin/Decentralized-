# Normalize line endings for all text files to LF
* text=auto

# Go source files
*.go text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# YAML/configuration
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Makefiles
Makefile text eol=lf
makefile text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary

# Source code diffs
*.diff text eol=lf
*.patch text eol=lf

# SQL
*.sql text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf
