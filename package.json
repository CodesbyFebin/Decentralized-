{
  "name": "mail-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "db:init": "sudo -u postgres psql -d decentralized_host -f db/schema.sql",
    "db:fixtures": "sudo -u postgres psql -d decentralized_host -f db/test-fixtures.sql"
  },
  "dependencies": {
    "express": "4.18.2",
    "bcryptjs": "2.4.3",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.11.3",
    "smtp-server": "3.11.0",
    "dotenv": "16.3.1",
    "cors": "2.8.5",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.10.6",
    "typescript": "5.3.3",
    "ts-node": "10.9.2",
    "nodemon": "3.0.2",
    "jest": "29.7.0",
    "@types/jest": "29.5.11",
    "ts-jest": "29.1.1"
  }
}
