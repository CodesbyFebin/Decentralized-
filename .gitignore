# Build outputs and local state
/bin/
/tools/bin/
/devcluster/
/dh-node-data/*
!/dh-node-data/policy.yaml
__pycache__/
*.pyc

# Node.js
node_modules/
package-lock.json
npm-debug.log
.next/
dist/

# Never commit private keys
*.key
identity.key
wg.key
bootstrap.code
bootstrap.fingerprint

# Evidence: sealed attempt directories are tracked in full, because a record
# only verifies if every hashed file is present, including the throwaway keys
# of its destroyed test clusters. The validator's signing key is never tracked.
/evidence/*
!/evidence/INDEX.md
!/evidence/PV1-S1-HISTORY.md
!/evidence/REF-MAC-A01/
!/evidence/REF-MAC-A02/
!/evidence/REF-MAC-A03/
!/evidence/pv1.1-linux-parity-docker-20260924T143020Z/
!/evidence/CC-RC1-A01/
!/evidence/CC-RC1-A02/
!/evidence/NODE-A01-A01/
!/evidence/NODE-A01-A02/
!/evidence/CC-W1-A01/
!/evidence/SEC-P0-A01-A04/
!/evidence/A05-P1-R1-A01-*/
!/evidence/A05-P0-A01-*/
!/evidence/*/**/*.key
/chaos-reports/runner/

# P1-LOCAL-VM-A01 runtime state (ephemeral QEMU cluster state, not tracked)
/validation/local-vm/state/
/p1-evidence/
/validation/local-vm/evidence/P1-CLOSE-A01-EXECUTION-*
dh

# Release artifacts (build outputs)
dh-v*.tar.gz
release-v*
evidence-v*
*-checksums.txt
